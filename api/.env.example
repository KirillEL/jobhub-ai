API_PORT=8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vacancies
POSTGRES_PORT=5434  # used by docker-compose.local.yml

# Local app settings
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5434/vacancies
CREATE_SCHEMA_ON_START=false
CORS_ALLOW_ORIGINS_RAW=http://localhost:3000,http://localhost:5173
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax

# Parser integration via internal HTTP service
PARSER_SERVICE_URL=http://parser:8080
PARSER_HTTP_PARSE_PATH=/parse
PARSER_HTTP_TIMEOUT_SECONDS=120
PARSER_AUTH_HEADER_NAME=X-Parser-Token
PARSER_AUTH_TOKEN=change-me
REQUEST_TIMEOUT_SECONDS=20

# Daily vacancy check scheduler
DAILY_CHECK_ENABLED=false
DAILY_CHECK_HOUR=9
DAILY_CHECK_MINUTE=0
DAILY_CHECK_TIMEZONE=Europe/Moscow
DAILY_CHECK_QUERY=python backend
DAILY_CHECK_PAGES=1

# Telegram notifications for daily checks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
