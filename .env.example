# Общий .env для запуска из корня: docker compose --env-file .env up -d
# Одна БД для API. Планировщик и Telegram — в API (см. docs/ARCHITECTURE.md).

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vacancies

# API (parser_api)
API_PORT=8000
CREATE_SCHEMA_ON_START=false
CORS_ALLOW_ORIGINS_RAW=http://localhost:3000,http://localhost:5173,https://jobhub.elertka.tech
JWT_SECRET=change-me-in-production
PARSER_AUTH_TOKEN=change-me

# Ежедневная проверка вакансий и отчёт в Telegram (внутри API)
DAILY_CHECK_ENABLED=true
DAILY_CHECK_USER_ID=
DAILY_CHECK_HOUR=9
DAILY_CHECK_MINUTE=0
DAILY_CHECK_TIMEZONE=Europe/Moscow
DAILY_CHECK_QUERY=python backend
DAILY_CHECK_PAGES=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
